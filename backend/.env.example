# Copy this file to .env and replace placeholders on your computer.
# Keep backend/.env private and never commit it.
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5174,http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Public Google client ID read by Vite; it must match GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
SESSION_SECRET=replace-with-a-random-value-at-least-32-characters-long
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
# Optional: promote only an existing Google-authenticated user with this email.
INITIAL_ADMIN_EMAIL=
